// Cloudflare Worker for the Emberreach companion API. See docs/adr/0002-backend-postgres.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emberreach-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // node-postgres needs Node.js APIs (net/tls sockets)
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every 10 minutes: check the database and re-add the Optilogic firewall rules if a restart dropped them.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Secret (not in this file): OPTILOGIC_APP_KEY, set with `npm run secrets` (reads the repo-root .env).
  "vars": {
    // Browser origins allowed to call the API (CORS). No paths, no trailing slash.
    "ALLOWED_ORIGINS": "https://morris-heap.github.io,http://localhost:5173"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the id printed by `npx wrangler hyperdrive create emberreach-db ...` (not a secret).
      // Local dev ignores it and uses CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (set by scripts/dev.mjs).
      "id": "aef614efc9394305841b9fa2210c9c16"
    }
  ]
}
